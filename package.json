{
  "name": "deep-time",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DEEP TIME \u2014 a cinematic browser simulation of the history of life and intelligence.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "check": "npm run build && npm test && npm run e2e:smoke"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@fontsource/lexend-exa": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}